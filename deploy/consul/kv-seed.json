  "antiCorruption": {
    "$comment": "灰度开关 KV（ConsulConfigWatcher 监听 leno/anticorruption/use-grpc/{bc}，不经过 leno/config 前缀），按 BC 独立键写入，默认 HTTP 轨（false）",
    "prefix": "leno/anticorruption/use-grpc/",
    "keys": [
      "accesscontrol",
      "aftersales",
      "cart",
      "identity",
      "inventory",
      "membership",
      "notification",
      "order",
      "payment",
      "points",
      "product",
      "promotion",
      "review",
      "sellershop",
      "systemadmin"
    ],
    "value": "false"
  }
}
