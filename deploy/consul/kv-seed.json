{
  "$comment": "Leno Consul KV 种子清单（P0-D）。键名 = 配置键（: → __），实际写入 Consul 时自动加前缀 leno/config/。value 支持 ${ENV_VAR} 占位符，由 seed-consul-kv.ps1 从环境变量解析；敏感值一律引用环境变量，本文件禁止出现真实密码。default 为占位符对应环境变量缺失时的非敏感默认值（仅非敏感项允许）。KV 键优先级高于 env 兜底（Winton Consul 源位于配置链尾），键映射规则见 deploy/docs/consul-kv-coverage-audit.md。",
  "prefix": "leno/config/",
  "items": [
    {
      "key": "ConnectionStrings__AccessControlDb",
      "value": "${LENO_DB_ACCESSCONTROL}"
    },
    {
      "key": "ConnectionStrings__AfterSalesDb",
      "value": "${LENO_DB_AFTERSALES}"
    },
    {
      "key": "ConnectionStrings__CartDb",
      "value": "${LENO_DB_CART}"
    },
    {
      "key": "ConnectionStrings__IdentityDb",
      "value": "${LENO_DB_IDENTITY}"
    },
    {
      "key": "ConnectionStrings__InventoryDb",
      "value": "${LENO_DB_INVENTORY}"
    },
    {
      "key": "ConnectionStrings__MembershipDb",
      "value": "${LENO_DB_MEMBERSHIP}"
    },
    {
      "key": "ConnectionStrings__NotificationDb",
      "value": "${LENO_DB_NOTIFICATION}"
    },
    {
      "key": "ConnectionStrings__OrderDb",
      "value": "${LENO_DB_ORDER}"
    },
    {
      "key": "ConnectionStrings__PaymentDb",
      "value": "${LENO_DB_PAYMENT}"
    },
    {
      "key": "ConnectionStrings__PointsDb",
      "value": "${LENO_DB_POINTS}"
    },
    {
      "key": "ConnectionStrings__ProductDb",
      "value": "${LENO_DB_PRODUCT}"
    },
    {
      "key": "ConnectionStrings__PromotionDb",
      "value": "${LENO_DB_PROMOTION}"
    },
    {
      "key": "ConnectionStrings__ReviewDb",
      "value": "${LENO_DB_REVIEW}"
    },
    {
      "key": "ConnectionStrings__SellerShopDb",
      "value": "${LENO_DB_SELLERSHOP}"
    },
    {
      "key": "ConnectionStrings__SystemAdminDb",
      "value": "${LENO_DB_SYSTEMADMIN}"
    },
    {
      "key": "ConnectionStrings__UserCenterDb",
      "value": "${LENO_DB_USERCENTER}"
    },
    {
      "key": "ConnectionStrings__SchedulerDb",
      "value": "${LENO_DB_SCHEDULER}"
    },
    {
      "key": "Redis__Configuration",
      "value": "${LENO_REDIS_CONFIGURATION}"
    },
    {
      "key": "RabbitMQ__Host",
      "value": "${LENO_RABBITMQ_HOST}",
      "default": "rabbitmq"
    },
    {
      "key": "RabbitMQ__Port",
      "value": "${LENO_RABBITMQ_PORT}",
      "default": "5672"
    },
    {
      "key": "RabbitMQ__Username",
      "value": "${LENO_RABBITMQ_USERNAME}",
      "default": "leno"
    },
    {
      "key": "RabbitMQ__Password",
      "value": "${LENO_RABBITMQ_PASSWORD}"
    },
    {
      "key": "RabbitMQ__VirtualHost",
      "value": "${LENO_RABBITMQ_VIRTUALHOST}",
      "default": "/"
    },
    {
      "key": "Elasticsearch__Uri",
      "value": "${LENO_ES_URI}"
    },
    {
      "key": "Jwt__DiscoveryUrl",
      "value": "${LENO_JWT_DISCOVERYURL}",
      "default": "http://leno-identity-api:8080/.well-known/openid-configuration"
    },
    {
      "key": "InternalAuth__ApiKey",
      "value": "${INTERNAL_AUTH_API_KEY}"
    },
    {
      "key": "Security__InternalApiKey__Shared",
      "value": "${LENO_INTERNAL_API_KEY_SHARED}"
    },
    {
      "key": "ServiceUrls__ProductApi",
      "value": "${LENO_SERVICEURL_PRODUCTAPI}",
      "default": "http://leno-product-api"
    },
    {
      "key": "ServiceUrls__PromotionApi",
      "value": "${LENO_SERVICEURL_PROMOTIONAPI}",
      "default": "http://leno-promotion-api"
    },
    {
      "key": "ServiceUrls__PointsApi",
      "value": "${LENO_SERVICEURL_POINTSAPI}",
      "default": "http://leno-points-api"
    },
    {
      "key": "ServiceUrls__OrderApi",
      "value": "${LENO_SERVICEURL_ORDERAPI}",
      "default": "http://leno-order-api"
    },
    {
      "key": "ServiceUrls__PaymentApi",
      "value": "${LENO_SERVICEURL_PAYMENTAPI}",
      "default": "http://leno-payment-api"
    },
    {
      "key": "ServiceUrls__AccessControlApi",
      "value": "${LENO_SERVICEURL_ACCESSCONTROLAPI}",
      "default": "http://leno-access-control-api"
    },
    {
      "key": "ServiceUrls__IdentityApi",
      "value": "${LENO_SERVICEURL_IDENTITYAPI}",
      "default": "http://leno-identity-api"
    },
    {
      "key": "Inventory__GrpcUrl",
      "value": "${LENO_INVENTORY_GRPCURL}",
      "default": "http://leno-inventory-api:5265"
    },
    {
      "key": "Payment__Alipay__AppId",
      "value": "${LENO_PAYMENT_ALIPAY_APPID}",
      "default": "local-placeholder"
    },
    {
      "key": "Payment__Alipay__PrivateKey",
      "value": "${LENO_PAYMENT_ALIPAY_PRIVATEKEY}",
      "default": "local-placeholder"
    },
    {
      "key": "Payment__Alipay__PublicKey",
      "value": "${LENO_PAYMENT_ALIPAY_PUBLICKEY}",
      "default": "local-placeholder"
    },
    {
      "key": "Payment__WeChatPay__AppId",
      "value": "${LENO_PAYMENT_WECHATPAY_APPID}",
      "default": "local-placeholder"
    },
    {
      "key": "Payment__WeChatPay__MchId",
      "value": "${LENO_PAYMENT_WECHATPAY_MCHID}",
      "default": "local-placeholder"
    },
    {
      "key": "Payment__WeChatPay__ApiKey",
      "value": "${LENO_PAYMENT_WECHATPAY_APIKEY}",
      "default": "local-placeholder"
    },
    {
      "key": "SMS__ApiKey",
      "value": "${LENO_SMS_APIKEY}",
      "default": "local-placeholder"
    },
    {
      "key": "SMS__ApiSecret",
      "value": "${LENO_SMS_APISECRET}",
      "default": "local-placeholder"
    },
    {
      "key": "OAuth2__WeChat__AppId",
      "value": "${LENO_OAUTH_WECHAT_APPID}",
      "default": "local-placeholder"
    },
    {
      "key": "OAuth2__WeChat__AppSecret",
      "value": "${LENO_OAUTH_WECHAT_APPSECRET}",
      "default": "local-placeholder"
    },
    {
      "key": "OAuth2__Apple__ClientId",
      "value": "${LENO_OAUTH_APPLE_CLIENTID}",
      "default": "local-placeholder"
    },
    {
      "key": "OAuth2__Apple__ClientSecret",
      "value": "${LENO_OAUTH_APPLE_CLIENTSECRET}",
      "default": "local-placeholder"
    }
