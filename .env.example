# Leno 电商平台环境变量模板
# 复制为 .env 并填入实际值

# JWT
JWT_SECRET_KEY=请填入至少64字节随机串

# SQL Server
MSSQL_SA_PASSWORD=请填入强密码

# RabbitMQ
RABBITMQ_DEFAULT_USER=leno
RABBITMQ_DEFAULT_PASS=请填入强密码

# Grafana
GF_SECURITY_ADMIN_USER=leno
GF_SECURITY_ADMIN_PASSWORD=请填入强密码

# InternalAuth（快轨临时共用，慢轨 M5.2 各 BC 独立）
INTERNAL_AUTH_API_KEY=请填入32字节随机串

# 内部服务间鉴权 Shared Key（代码读取键 Security:InternalApiKey:Shared，
# ConfigCenterExtensions.ValidateSensitiveConfig 兼容期校验用，至少 32 字节）
LENO_INTERNAL_API_KEY_SHARED=请填入32字节随机串

# 各 BC 独立内部鉴权 Key（代码读取键 Security:InternalApiKey:{Bc}，
# 防腐层 ACL 调用对端 internal/ 接口时携带，见 Order appsettings AntiCorruption 节）
LENO_INTERNAL_API_KEY_PRODUCT=请填入32字节随机串
LENO_INTERNAL_API_KEY_PROMOTION=请填入32字节随机串
LENO_INTERNAL_API_KEY_POINTSMEMBERSHIP=请填入32字节随机串

# OAuth2 登录页公开基础地址（代码读取键 OAuth2:PublicBaseUrl，
# 用于构造第三方登录回调跳转，无需保密）
OAUTH2_PUBLIC_BASE_URL=https://auth.leno.example.com

# —— 以下供 deploy/scripts/create-secrets.ps1 / seed-consul-kv.ps1 引用 ——
# Consul 地址（leno-consul-address Secret / KV 种子脚本）
LENO_CONSUL_URL=http://localhost:8500
# Redis 连接串（leno-redis-connection Secret）
LENO_REDIS_CONFIGURATION=redis:6379
# Elasticsearch 地址（leno-es-connection Secret）
LENO_ES_URI=http://localhost:9200
# RabbitMQ（leno-mq-rabbitmq Secret）
LENO_RABBITMQ_HOST=rabbitmq
LENO_RABBITMQ_PORT=5672
LENO_RABBITMQ_USERNAME=leno
LENO_RABBITMQ_PASSWORD=请填入强密码
# 数据库连接串（leno-db-connectionstrings Secret，key={Bc}Db；按需填写用到的 BC）
# LENO_DB_ORDER=Server=sqlserver,1433;Database=LenoOrder;User Id=sa;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_USERAUTH=Server=sqlserver,1433;Database=LenoUserAuth;User Id=sa;Password=请填入强密码;TrustServerCertificate=True
