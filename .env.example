# Leno 电商平台环境变量模板
# 复制为 .env 并填入实际值

# JWT
JWT_SECRET_KEY=请填入至少64字节随机串

# SQL Server（staging K8s mssql：leno-staging-mssql Secret 的 password key 用此值，见 deploy/staging/README.md）
MSSQL_SA_PASSWORD=请填入强密码

# Redis（compose redis-server requirepass 与各服务连接串 password= 共用；
# 未设置时 compose 回退到公开 dev 默认 leno-redis-dev，连接串须与之一致）
REDIS_PASSWORD=请填入强密码

# RabbitMQ
RABBITMQ_DEFAULT_USER=leno
RABBITMQ_DEFAULT_PASS=请填入强密码

# Grafana
GF_SECURITY_ADMIN_USER=leno
GF_SECURITY_ADMIN_PASSWORD=请填入强密码

# InternalAuth（快轨临时共用，慢轨 M5.2 各 BC 独立）
INTERNAL_AUTH_API_KEY=请填入32字节随机串

# 内部服务间鉴权 Shared Key（代码读取键 Security:InternalApiKey:Shared，
# ConfigCenterExtensions.ValidateSensitiveConfig 兼容期校验用，至少 32 字节）
LENO_INTERNAL_API_KEY_SHARED=请填入32字节随机串

# 各 BC 独立内部鉴权 Key（代码读取键 Security:InternalApiKey:{Bc}，
# 防腐层 ACL 调用对端 internal/ 接口时携带，见 Order appsettings AntiCorruption 节）
LENO_INTERNAL_API_KEY_PRODUCT=请填入32字节随机串
LENO_INTERNAL_API_KEY_PROMOTION=请填入32字节随机串
LENO_INTERNAL_API_KEY_POINTSMEMBERSHIP=请填入32字节随机串

# Identity JWT RS256 签名私钥（PEM 格式，供 EnvironmentKms 读取环境变量 JWT_RSA_PRIVATE_KEY_PEM）。
# 多行 PEM 在 .env 中用双引号包裹、换行写成 \n 转义（docker compose 的 dotenv 解析器会还原为真实换行）。
# 生成方式：openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048，
# 再执行：python -c "import sys;print('JWT_RSA_PRIVATE_KEY_PEM=\"'+open('private.pem').read().strip().replace(chr(10),'\\n')+'\"')"
# 未配置时 Identity 签发访问令牌会失败（No supported key formats were found）。
JWT_RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n请填入 Base64 私钥内容\n-----END PRIVATE KEY-----"

# OAuth2 登录页公开基础地址（代码读取键 OAuth2:PublicBaseUrl，
# 用于构造第三方登录回调跳转，无需保密）
OAUTH2_PUBLIC_BASE_URL=https://auth.leno.example.com

# —— 以下供 deploy/scripts/create-secrets.ps1 / seed-consul-kv.ps1 引用 ——
# Consul 地址（leno-consul-address Secret / KV 种子脚本）
LENO_CONSUL_URL=http://localhost:8500
# Consul ACL token（seed-consul-kv.ps1 对启用 ACL 的集群必填，也是 leno-consul-token
# Secret 的来源；staging 取值方式见 deploy/staging/README.md 步骤 1 / 4.2）
LENO_CONSUL_TOKEN=
# Redis 连接串（leno-redis-connection Secret；本机 compose 场景 password 与 REDIS_PASSWORD 保持一致）
LENO_REDIS_CONFIGURATION=redis:6379,password=<与 REDIS_PASSWORD 一致>
# Elasticsearch 地址（leno-es-connection Secret）
LENO_ES_URI=http://localhost:9200
# RabbitMQ（leno-mq-rabbitmq Secret）
LENO_RABBITMQ_HOST=rabbitmq
LENO_RABBITMQ_PORT=5672
LENO_RABBITMQ_USERNAME=leno
LENO_RABBITMQ_PASSWORD=请填入强密码
LENO_RABBITMQ_VIRTUALHOST=/
# 数据库连接串（leno-db-connectionstrings Secret，key={Bc}Db；按需填写用到的 BC）
# staging 约定：host=sqlserver.leno.svc（mssql-staging.yaml 的 Service），
# 数据库名 = Leno{Bc}（与 seed-consul-kv.ps1 -BcList 的 key 推导一致，
# 见 deploy/docs/consul-kv-coverage-audit.md §3.1）。以下 19 个键与
# create-secrets.ps1 默认 BcList、kv-seed.json 逐一对应。
# LENO_DB_ACCESSCONTROL=Server=sqlserver.leno.svc,1433;Database=LenoAccessControl;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_AFTERSALES=Server=sqlserver.leno.svc,1433;Database=LenoAfterSales;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_CART=Server=sqlserver.leno.svc,1433;Database=LenoCart;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_IDENTITY=Server=sqlserver.leno.svc,1433;Database=LenoIdentity;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_INVENTORY=Server=sqlserver.leno.svc,1433;Database=LenoInventory;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_MEMBERSHIP=Server=sqlserver.leno.svc,1433;Database=LenoMembership;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_NOTIFICATION=Server=sqlserver.leno.svc,1433;Database=LenoNotification;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_ORDER=Server=sqlserver.leno.svc,1433;Database=LenoOrder;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_PAYMENT=Server=sqlserver.leno.svc,1433;Database=LenoPayment;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_POINTS=Server=sqlserver.leno.svc,1433;Database=LenoPoints;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_POINTSMEMBERSHIP=Server=sqlserver.leno.svc,1433;Database=LenoPointsMembership;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_PRODUCT=Server=sqlserver.leno.svc,1433;Database=LenoProduct;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_PROMOTION=Server=sqlserver.leno.svc,1433;Database=LenoPromotion;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_REVIEW=Server=sqlserver.leno.svc,1433;Database=LenoReview;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_REVIEWAFTERSALES=Server=sqlserver.leno.svc,1433;Database=LenoReviewAfterSales;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_SELLERSHOP=Server=sqlserver.leno.svc,1433;Database=LenoSellerShop;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_SYSTEMADMIN=Server=sqlserver.leno.svc,1433;Database=LenoSystemAdmin;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_USERAUTH=Server=sqlserver.leno.svc,1433;Database=LenoUserAuth;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True
# LENO_DB_USERCENTER=Server=sqlserver.leno.svc,1433;Database=LenoUserCenter;User Id=leno_app;Password=请填入强密码;TrustServerCertificate=True

# 服务发现兜底地址（kv-seed.json ServiceUrls__*，均有脚本内 default 值，可选）
# LENO_SERVICEURL_PRODUCTAPI=http://leno-product-api
# LENO_SERVICEURL_PROMOTIONAPI=http://leno-promotion-api
# LENO_SERVICEURL_POINTSMEMBERSHIPAPI=http://leno-pointsmembership-api
# LENO_SERVICEURL_ORDERAPI=http://leno-order-api
# LENO_SERVICEURL_PAYMENTAPI=http://leno-payment-api
# LENO_SERVICEURL_ACCESSCONTROLAPI=http://leno-access-control-api
# LENO_SERVICEURL_USERAUTHAPI=http://leno-user-auth-api

# —— 本地 docker compose 全栈必需键（compose 会直接引用，缺一不可）——
# 16 个 API 的 {Bc}Db 连接串（compose 变量：LENO_DB_ACCESSCONTROL / AFTERSALES / CART /
# IDENTITY / INVENTORY / MEMBERSHIP / NOTIFICATION / ORDER / PAYMENT / POINTS / PRODUCT /
# PROMOTION / REVIEW / SELLERSHOP / SYSTEMADMIN / USERCENTER），本机场景 host=sqlserver
LENO_DB_ACCESSCONTROL=Server=sqlserver;Database=leno_access_control;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_AFTERSALES=Server=sqlserver;Database=leno_aftersales;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_CART=Server=sqlserver;Database=leno_cart;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_IDENTITY=Server=sqlserver;Database=leno_identity;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_INVENTORY=Server=sqlserver;Database=leno_inventory;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_MEMBERSHIP=Server=sqlserver;Database=leno_membership;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_NOTIFICATION=Server=sqlserver;Database=leno_notification;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_ORDER=Server=sqlserver;Database=LenoOrder;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_PAYMENT=Server=sqlserver;Database=leno_payment;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_POINTS=Server=sqlserver;Database=leno_points;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_PRODUCT=Server=sqlserver;Database=leno_product;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_PROMOTION=Server=sqlserver;Database=leno_promotion;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_REVIEW=Server=sqlserver;Database=leno_review;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_SELLERSHOP=Server=sqlserver;Database=leno_seller_shop;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_SYSTEMADMIN=Server=sqlserver;Database=leno_system_admin;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
LENO_DB_USERCENTER=Server=sqlserver;Database=leno_user_center;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true
# Quartz 调度库（scheduler-db-init 一次性建库建表；16 个 API 共享）
LENO_DB_SCHEDULER=Server=sqlserver;Database=LenoScheduler;User Id=sa;Password=<与 MSSQL_SA_PASSWORD 一致>;TrustServerCertificate=true

# 各 BC 目标端内部鉴权 Key（防腐层 ACL 调用对端 internal/ 接口时携带）
LENO_INTERNAL_API_KEY_POINTS=请填入32字节随机串
LENO_INTERNAL_API_KEY_IDENTITY=请填入32字节随机串
LENO_INTERNAL_API_KEY_ORDER=请填入32字节随机串
LENO_INTERNAL_API_KEY_PAYMENT=请填入32字节随机串

# 支付渠道密钥（仅 payment-api 注入，Service:Name=Payment 才校验）
LENO_PAYMENT_ALIPAY_APPID=请填入支付宝 AppId
LENO_PAYMENT_ALIPAY_PRIVATEKEY=请填入支付宝应用私钥
LENO_PAYMENT_ALIPAY_PUBLICKEY=请填入支付宝公钥
LENO_PAYMENT_WECHATPAY_APPID=请填入微信支付 AppId
LENO_PAYMENT_WECHATPAY_MCHID=请填入微信支付商户号
LENO_PAYMENT_WECHATPAY_APIKEY=请填入微信支付 APIv3 密钥

# 短信密钥（仅 notification-api 注入，Service:Name=Notification 才校验）
LENO_SMS_APIKEY=请填入短信服务 AccessKey
LENO_SMS_APISECRET=请填入短信服务 Secret

# 第三方登录密钥（仅 identity-api 注入，Service:Name=Identity 才校验）
LENO_OAUTH_WECHAT_APPID=请填入微信开放平台 AppId
LENO_OAUTH_WECHAT_APPSECRET=请填入微信开放平台 AppSecret
LENO_OAUTH_APPLE_CLIENTID=请填入 Sign in with Apple ClientId
LENO_OAUTH_APPLE_CLIENTSECRET=请填入 Sign in with Apple ClientSecret
# OAuth2:AesKey 必须是 Base64 编码的 32 字节密钥（可用
# [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes('<32字节字符串>')) 生成）
OAUTH2_AES_KEY=请填入Base64编码的32字节密钥
# PasswordHash:Pepper 口令哈希胡椒（至少 32 字节随机串）
PASSWORD_PEPPER=请填入32字节随机串

