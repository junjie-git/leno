      "system-scheduled-tasks": { "ClusterId": "system-admin", "Match": { "Path": "/api/scheduled-tasks/{**catch-all}" }, "Order": 10 },
      "system-audit-logs": { "ClusterId": "system-admin", "Match": { "Path": "/api/audit-logs/{**catch-all}" }, "Order": 10 }
    },
    "Clusters": {
      "user-auth": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "consul": { "Address": "http://placeholder", "Metadata": { "ConsulServiceName": "leno-user-auth-api" } }
