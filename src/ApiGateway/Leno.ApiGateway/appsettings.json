      "points-packages":        { "ClusterId": "points",           "RateLimiterPolicy": "leno-default",  "TimeoutPolicy": "leno-default",  "Match": { "Path": "/api/membership-packages/{**catch-all}" },  "Order": 10 },
      "review":                 { "ClusterId": "review-aftersales", "RateLimiterPolicy": "leno-default", "TimeoutPolicy": "leno-default",  "Match": { "Path": "/api/reviews/{**catch-all}" },               "Order": 10 },
      "review-admin":           { "ClusterId": "review-aftersales", "RateLimiterPolicy": "leno-default", "TimeoutPolicy": "leno-default",  "Match": { "Path": "/api/admin/reviews/{**catch-all}" },         "Order": 10 },
      "after-sales":            { "ClusterId": "review-aftersales", "RateLimiterPolicy": "leno-default", "TimeoutPolicy": "leno-default",  "Match": { "Path": "/api/after-sales/{**catch-all}" },           "Order": 10 },
      "after-sales-admin":      { "ClusterId": "review-aftersales", "RateLimiterPolicy": "leno-default", "TimeoutPolicy": "leno-default",  "Match": { "Path": "/api/admin/after-sales/{**catch-all}" },      "Order": 10 },
      "shops":                  { "ClusterId": "seller-shop",      "RateLimiterPolicy": "leno-default",  "TimeoutPolicy": "leno-default",  "Match": { "Path": "/api/shops/{**catch-all}" },                 "Order": 10 },
      "shops-admin":            { "ClusterId": "seller-shop",      "RateLimiterPolicy": "leno-default",  "TimeoutPolicy": "leno-default",  "Match": { "Path": "/api/admin/shops/{**catch-all}" },           "Order": 10 },
      "seller":                 { "ClusterId": "seller-shop",      "RateLimiterPolicy": "leno-default",  "TimeoutPolicy": "leno-default",  "Match": { "Path": "/api/seller/{**catch-all}" },                 "Order": 20 },
