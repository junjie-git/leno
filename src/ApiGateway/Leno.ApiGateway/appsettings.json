{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HealthChecks": {
    "Services": {
      "user-auth": "http://localhost:5173",
      "product": "http://localhost:5150",
      "cart": "http://localhost:5151",
      "order": "http://localhost:5154",
      "promotion": "http://localhost:5152",
      "payment": "http://localhost:5155",
      "points": "http://localhost:5153",
      "review-aftersales": "http://localhost:5156",
      "seller-shop": "http://localhost:5149",
      "notification": "http://localhost:5157",
      "system-admin": "http://localhost:5158"
    }
  },
  "Consul": {
    "Url": "http://localhost:8500",
    "Token": "",
    "PassingOnly": true
  },
  "ReverseProxy": {
    "Routes": {
      "user-auth": { "ClusterId": "user-auth", "Match": { "Path": "/api/auth/{**catch-all}" }, "Order": 10 },
      "user-auth-users": { "ClusterId": "user-auth", "Match": { "Path": "/api/users/{**catch-all}" }, "Order": 10 },
