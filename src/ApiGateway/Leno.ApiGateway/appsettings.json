      "shops-admin": { "ClusterId": "seller-shop", "Match": { "Path": "/api/admin/shops/{**catch-all}" }, "Order": 10 },
      "seller": { "ClusterId": "seller-shop", "Match": { "Path": "/api/seller/{**catch-all}" }, "Order": 20 },
