{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Application": {
    "Name": "leno-order-api"
  },
  "Service": {
    "Name": "Order"
  },
  "Consul": {
    "Url": "http://localhost:8500",
    "ServiceAddress": "localhost",
    "ServicePort": 8080
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "leno-order-api"
  },
  "ConnectionStrings": {
    "SchedulerDb": "Server=localhost,1433;Database=LenoScheduler;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true",
    "OrderDb": "Server=localhost,1433;Database=LenoOrder;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "leno-identity",
    "Audience": "leno-clients",
    "AccessTokenExpiryMinutes": 120,
    "RefreshTokenExpiryDays": 7,
    "DiscoveryUrl": "http://localhost:5162/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "InternalAuth": {
    "ApiKey": "${INTERNAL_AUTH_API_KEY}"
  },
  "Security": {
    "InternalApiKey": {
      "Shared": "${LENO_INTERNAL_API_KEY_SHARED}"
    }
  },
  "ServiceUrls": {
    "ProductApi": "http://localhost:5150",
    "PromotionApi": "http://localhost:5152",
    "PointsApi": "http://localhost:5166"
  },
  "Inventory": {
    "GrpcUrl": "http://localhost:5265"
  },
  "AntiCorruption": {
    "TargetInternalApiKeys": {
      "Product": "${LENO_INTERNAL_API_KEY_PRODUCT}",
      "Promotion": "${LENO_INTERNAL_API_KEY_PROMOTION}",
      "Points": "${LENO_INTERNAL_API_KEY_POINTS}"
    }
  },
  "LogisticsApi": {
    "ApiUrl": "https://api.kdniao.com/Ebusiness/EbusinessOrderHandle.aspx",
    "AppKey": ""
  }
}
