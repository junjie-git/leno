{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Application": {
    "Name": "leno-identity-api"
  },
  "Service": {
    "Name": "Identity"
  },
  "Consul": {
    "Url": "http://localhost:8500",
    "ServiceAddress": "localhost",
    "ServicePort": 8083
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "leno-identity-api"
  },
  "ConnectionStrings": {
    "IdentityDb": "Server=localhost,1433;Database=LenoIdentity;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Auth": {
    "Mode": "JwtBearer"
  },
  "Jwt": {
    "Issuer": "leno-identity",
    "Audience": "leno-clients",
    "SecretKey": "${JWT_SECRET_KEY}",
    "AccessTokenExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7
  },
  "Identity": {
    "Jwt": {
      "Issuer": "leno-identity",
      "Audience": "leno-clients",
      "SigningKey": "${JWT_SECRET_KEY}",
      "AccessTokenExpirationMinutes": 30,
      "RefreshTokenExpirationDays": 7
    }
  },
  "PasswordHash": {
    "DegreeOfParallelism": 4,
    "MemorySizeKB": 65536,
    "Iterations": 3,
    "HashLengthBytes": 32,
    "SaltLengthBytes": 16,
    "Pepper": "${PASSWORD_PEPPER}",
    "UseKmsForPepper": false,
    "WrappedPepper": ""
  },
  "JwtSigning": {
    "SigningMode": "Hs256",
    "CurrentKeyId": "key-v1",
    "TokenTtlMinutes": 30,
    "Hs256SigningKey": "${JWT_SECRET_KEY}",
    "Issuer": "leno-identity",
    "Audience": "leno-clients",
    "RsaPrivateKeyPem": "${JWT_RSA_PRIVATE_KEY_PEM}",
    "RsaPublicKeyPem": "${JWT_RSA_PUBLIC_KEY_PEM}",
    "UseAzureKeyVault": false,
    "KeyVaultUri": ""
  },
  "ServiceUrls": {
    "AccessControlApi": "http://localhost:8082"
  },
  "AntiCorruption": {
    "UseGrpc": true,
    "GrpcEndpoints": {
      "AccessControl": "http://localhost:8082"
    }
  },
  "InternalAuth": {
    "ApiKey": "${INTERNAL_AUTH_API_KEY}"
  },
  "Security": {
    "InternalApiKey": {
      "Shared": "${LENO_INTERNAL_API_KEY_SHARED}"
    }
  }
}
