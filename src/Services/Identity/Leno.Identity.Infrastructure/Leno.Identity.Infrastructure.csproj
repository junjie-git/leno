<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Leno.Identity.Domain\Leno.Identity.Domain.csproj" />
    <ProjectReference Include="..\Leno.Identity.Application\Leno.Identity.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Leno.SharedKernel\Leno.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Leno.SharedContracts\Leno.SharedContracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Leno.Infrastructure\Leno.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Leno.SharedContracts.Grpc\Leno.SharedContracts.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <!--
    AccessControlService 的 gRPC 类型（Client/Server 均由同一个生成文件产出）统一来自
    Leno.SharedContracts.Grpc/Generated/AccessControlGrpc.cs（buf 模块 src/BuildingBlocks/Leno.SharedContracts）。
    本项目经传递引用（Infrastructure → Application → Leno.SharedContracts.Grpc）访问该类型。
    Grpc.Net.Client 保留以提供 AddGrpcClient<T> 扩展方法注册入口。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Leno.Identity.Infrastructure.Tests" />
  </ItemGroup>

</Project>
