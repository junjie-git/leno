{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Application": {
    "Name": "leno-seller-shop-api"
  },
  "Service": {
    "Name": "SellerShop"
  },
  "Consul": {
    "Url": "http://localhost:8500",
    "ServiceAddress": "localhost",
    "ServicePort": 8080
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "leno-seller-shop-api"
  },
  "ConnectionStrings": {
    "SchedulerDb": "Server=localhost,1433;Database=LenoScheduler;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true",
    "SellerShopDb": "Server=localhost,1433;Database=LenoSellerShop;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "leno-identity",
    "Audience": "leno-clients",
    "AccessTokenExpiryMinutes": 120,
    "RefreshTokenExpiryDays": 7,
    "DiscoveryUrl": "http://localhost:5162/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "InternalAuth": {
    "ApiKey": "${INTERNAL_AUTH_API_KEY}"
  },
  "Security": {
    "InternalApiKey": {
      "Shared": "${LENO_INTERNAL_API_KEY_SHARED}"
    }
  },
  "AntiCorruption": {
    "GrpcEndpoints": {
      "Product": "http://localhost:5252",
      "Order": "http://localhost:5254",
      "Review": "http://localhost:5268"
    },
    "TargetInternalApiKeys": {
      "Product": "${LENO_INTERNAL_API_KEY_SHARED}",
      "Order": "${LENO_INTERNAL_API_KEY_SHARED}",
      "Review": "${LENO_INTERNAL_API_KEY_SHARED}"
    }
  },
  "QualificationReminder": {
    "ReminderDays": [
      30,
      7,
      1
    ],
    "ScanIntervalHours": 24
  }
}
