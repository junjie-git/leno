{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "SchedulerDb": "Server=localhost,1433;Database=LenoScheduler;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true",
    "AfterSalesDb": "Server=localhost;Database=leno_aftersales;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=true;MultipleActiveResultSets=true"
  },
  "Consul": {
    "Address": "http://localhost:8500",
    "ServiceName": "leno-aftersales-api",
    "ServiceId": "leno-aftersales-api-1"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "leno-identity",
    "Audience": "leno-clients",
    "DiscoveryUrl": "http://localhost:5162/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "AntiCorruption": {
    "GrpcEndpoints": {
      "Order": "http://localhost:5254",
      "Payment": "http://localhost:5256"
    },
    "TargetInternalApiKeys": {
      "Order": "${LENO_INTERNAL_API_KEY_SHARED}",
      "Payment": "${LENO_INTERNAL_API_KEY_SHARED}"
    }
  }
}
