{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Application": {
    "Name": "leno-inventory-api"
  },
  "Service": {
    "Name": "Inventory"
  },
  "Consul": {
    "Url": "http://localhost:8500",
    "ServiceAddress": "localhost",
    "ServicePort": 5160
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "leno-inventory-api"
  },
  "ConnectionStrings": {
    "SchedulerDb": "Server=localhost,1433;Database=LenoScheduler;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true",
    "InventoryDb": "Server=localhost,1433;Database=LenoInventory;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": "5672",
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "Jwt": {
    "Issuer": "leno-identity",
    "Audience": "leno-clients",
    "AccessTokenExpiryMinutes": 120,
    "RefreshTokenExpiryDays": 7,
    "DiscoveryUrl": "http://localhost:5162/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "InternalAuth": {
    "ApiKey": "${INTERNAL_AUTH_API_KEY}"
  },
  "Security": {
    "InternalApiKey": {
      "Shared": "${LENO_INTERNAL_API_KEY_SHARED}"
    }
  },
  "StockReservationCompensation": {
    "Interval": "00:05:00",
    "BatchSize": 50
  },
  "MassTransit": {
    "Retry": {
      "Count": 5,
      "Incremental": true,
      "Interval": "00:00:10"
    }
  }
}
